# Copy this file to .env for local Expo development.
# Do not commit real keys.

# Preferred for real builds: point the app to your own server-side proxy.
EXPO_PUBLIC_IMAGE_POSTERIZE_ENDPOINT=

# Local/dev-only direct model config. Add your Nano Banana / Gemini image key here.
# EXPO_PUBLIC values are bundled into the app, so use a proxy for real distribution.
EXPO_PUBLIC_NANO_BANANA_API_KEY=
EXPO_PUBLIC_NANO_BANANA_MODEL=gemini-2.5-flash-image
